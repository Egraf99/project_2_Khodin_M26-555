[2.045209, "o", "\r\n$ uv run database\r\n"]
[2.195689, "o", "\r\r\n***Процесс работы с таблицей***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n<command> insert into <таблица> values (<значения>) - добавить запись\r\r\n<command> select from <таблица> [where <условие>] - показать записи\r\r\n<command> update <таблица> set <значения> where <условие> - обновить\r\r\n<command> delete from <таблица> where <условие> - удалить записи\r\r\n<command> info <таблица> - информация о таблице\r\r\n\r\r\nОбщие команды:\r\r\n<command> exit - выход из программы\r\r\n<command> help - справочная информация\r\r\n\r\r\nВведите команду: "]
[3.196128, "o", "create_table users name:str age:int is_active:bool\r\r\n"]
[3.197258, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\r\n"]
[3.197402, "o", "Введите команду: "]
[4.197768, "o", "insert into users values (\"Sergei\", 28, true)\r\r\n"]
[4.198588, "o", "Функция insert выполнилась за 0.000 секунд\r\r\n"]
[4.198907, "o", "Запись с ID=1 добавлена в таблицу \"users\".\r\r\n"]
[4.199077, "o", "Введите команду: "]
[5.1997, "o", "insert into users values (\"Anna\", 30, false)\r\r\n"]
[5.200493, "o", "Функция insert выполнилась за 0.000 секунд\r\r\n"]
[5.20132, "o", "Запись с ID=2 добавлена в таблицу \"users\".\r\r\n"]
[5.201493, "o", "Введите команду: "]
[6.201669, "o", "select from users\r\r\n"]
[6.201945, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[6.258028, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  28 |    True   |\r\r\n| 2  |  Anna  |  30 |   False   |\r\r\n+----+--------+-----+-----------+\r\r\nВведите команду: "]
[7.258186, "o", "select from users\r\r\n"]
[7.258738, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  28 |    True   |\r\r\n| 2  |  Anna  |  30 |   False   |\r\r\n+----+--------+-----+-----------+\r\r\n"]
[7.258795, "o", "Введите команду: "]
[8.259114, "o", "insert into users values (\"Bad\", \"28\", true)\r\r\n"]
[8.25979, "o", "Некорректное значение: 28. Столбец \"age\" должен иметь тип int. Попробуйте снова.\r\r\n"]
[8.259959, "o", "Введите команду: "]
[9.260319, "o", "update users set age = 29 where name = \"Sergei\"\r\r\n"]
[9.2609, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[9.261102, "o", "Запись с ID=1 в таблице \"users\" обновлена.\r\r\n"]
[9.261248, "o", "Введите команду: "]
[10.261695, "o", "select from users where age = 29\r\r\n"]
[10.262408, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[10.262933, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  29 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\nВведите команду: "]
[11.263296, "o", "delete from users where ID = 1\r\r\n"]
[11.264349, "o", "Функция select выполнилась за 0.000 секунд\r\r\nВы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[12.264634, "o", "n\r\r\n"]
[12.264952, "o", "Операция отменена.\r\r\n"]
[12.265162, "o", "Введите команду: "]
[13.265573, "o", "select from users\r\r\n"]
[13.266504, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[13.267646, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  29 |    True   |\r\r\n| 2  |  Anna  |  30 |   False   |\r\r\n+----+--------+-----+-----------+\r\r\n"]
[13.267824, "o", "Введите команду: "]
[14.268047, "o", "delete from users where ID = 1\r\r\n"]
[14.268525, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[14.268577, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[15.268947, "o", "y\r\r\n"]
