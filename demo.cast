[16.271417, "o", "Таблица: users\r\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\r\nКоличество записей: 1\r\r\n"]
[16.271697, "o", "Введите команду: "]
[17.271942, "o", "select from users\r\r\n"]
[17.27262, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[17.273268, "o", "+----+------+-----+-----------+\r\r\n| ID | name | age | is_active |\r\r\n+----+------+-----+-----------+\r\r\n| 2  | Anna |  30 |   False   |\r\r\n+----+------+-----+-----------+\r\r\n"]
[17.273543, "o", "Введите команду: "]
[18.273752, "o", "drop_table users\r\r\n"]
[18.273852, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[19.274208, "o", "n\r\r\nОперация отменена.\r\r\n"]
[19.274555, "o", "Введите команду: "]
[20.27494, "o", "list_tables\r\r\n"]
[20.27526, "o", "- users\r\r\n"]
[20.275516, "o", "Введите команду: "]
